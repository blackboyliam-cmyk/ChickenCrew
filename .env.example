AUTH_SECRET=replace-with-a-long-random-string
# Your admin sign-in. Keep this private. Do not send it to Razorpay.
ADMIN_EMAIL=
ADMIN_PASSWORD=replace-me
# Customer-only test login for Razorpay's website review. No admin access.
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORD=
OTP_DEV_MODE=true
NEXT_PUBLIC_SITE_URL=https://karthikachickencentre.shop
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# SMS login codes via renflair.in. Required unless OTP_DEV_MODE=true in local development.
RENFLAIR_API_KEY=
# Leave MONGODB_URI empty to keep using data/db.json locally. Required on Vercel.
MONGODB_URI=
MONGODB_DB=chickencrew
# Email OTP sign-in via resend.com. Without this, email login only works locally with OTP_DEV_MODE=true.
RESEND_API_KEY=
# Verified sender, e.g. ChickenCrew <signin@yourdomain.com>. Leave empty to use Resend's test sender.
EMAIL_FROM=
# "Continue with Google" sign-in. OAuth client (Web application) from Google Cloud Console.
# Authorised redirect URI: <your site>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Address pin map and live rider tracking. Enable Maps JavaScript API, Places API (New) and Geocoding API.
# Restrict the key to your site's HTTP referrers. Without it, checkout falls back to a GPS pin.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
